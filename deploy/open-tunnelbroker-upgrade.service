[Unit]
Description=Upgrade Open IPv6 Tunnelbroker from Git
Documentation=https://github.com/open-tunnelbroker/open-tunnelbroker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/open-tunnelbroker-upgrade
EnvironmentFile=-/etc/open-tunnelbroker/upgrade
User=root
Group=root
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
