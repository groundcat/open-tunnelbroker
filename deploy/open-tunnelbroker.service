[Unit]
Description=Open IPv6 Tunnelbroker
Documentation=https://github.com/open-tunnelbroker/open-tunnelbroker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/open-tunnelbroker -db /var/lib/open-tunnelbroker/broker.db -listen 127.0.0.1:8080
EnvironmentFile=-/etc/open-tunnelbroker/environment
Restart=on-failure
RestartSec=3
User=root
Group=root
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/open-tunnelbroker
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
